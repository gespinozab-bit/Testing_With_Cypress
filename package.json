{
  "name": "cafe-central",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "setup": "pnpm install",
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --env-file=.env.development server/index.ts",
    "dev:web": "vite --configLoader runner --host localhost --port 5173 --strictPort",
    "dev:test": "concurrently -k -n api,web \"pnpm api:test\" \"pnpm dev:web\"",
    "api:test": "tsx --env-file=.env.test server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build --configLoader runner",
    "start": "node --env-file=.env.production dist-server/index.js",
    "verify:api": "node scripts/verify-api.mjs",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "cypress": "^16.2.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "cypress"
    ]
  }
}
